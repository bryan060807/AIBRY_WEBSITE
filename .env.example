# Copy to .env.local or your PM2 runtime env file.
# Never commit real values.

AIBRY_BACKEND_BASE_URL=http://fedora-garage:PORT
# Optional compatibility fallback for older runtime configs:
# AIBRY_WEBSITE_API_URL=http://fedora-garage:PORT
# Optional server-only backend auth. Never expose through NEXT_PUBLIC_*.
# AIBRY_BACKEND_INTERNAL_TOKEN=replace-me

AIBRY_STORAGE_DRIVER=s3
AIBRY_S3_ENDPOINT=https://s3.example.internal
AIBRY_S3_REGION=us-east-1
AIBRY_S3_BUCKET=avatars
AIBRY_S3_ACCESS_KEY_ID=replace-me
AIBRY_S3_SECRET_ACCESS_KEY=replace-me
AIBRY_MEDIA_PUBLIC_URL=https://media.aibry.shop
